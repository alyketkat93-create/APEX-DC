    "letterDate": "2026-10-05",
    "receivedDispatchedDate": "2026-10-05",
    "sender": "APEX Engineering & Construction JV",
    "recipient": "Dar Al-Handasah Consultants (Shair and Partners)",
    "ccList": "King Salman Park Foundation (Employer), Project Director",
    "subject": "Urgent Clarification on Chilled Water Riser Penetrations through Structural Shear Wall SW-04",
    "discipline": "MEP-HVAC",
    "contractClauseRef": "FIDIC Cl. 1.9 (Delayed Drawings or Instructions)",
    "relatedDrawingId": "drw-1",
    "relatedRfiId": "rfi-1",
    "actionRequired": "Consultant Formal Instruction & Approved Detail",
    "responsiblePerson": "Eng. Aly Ketkat",
    "responseDeadline": "2026-10-12",
    "status": "Dispatched",
    "confidentiality": "Normal",
    "letterBody": "Dear Sirs,\n\nWe refer to the ongoing shop drawing coordination for the Central Chiller Plant piping (Drawing Ref: APX-KSP-03-MEP-HVAC-0042) and RFI-0014 submitted on 22 September 2026.\n\nSite surveys indicate that post-tensioned shear wall SW-04 at Grid Line D/7 conflicts with the 450mm chilled water riser sleeves. As per structural general notes, core-drilling through prestressing tendon zones is strictly prohibited.\n\nWe urgently request your formal engineering instructions and revised penetration details to prevent critical path stoppage for the basement MEP installation works.\n\nYours faithfully,\nFor APEX Engineering & Construction JV\nEng. Aly Ketkat — Document Control Manager",
    "createdAt": "2026-10-05T09:00:00Z",
    "updatedAt": "2026-10-05T10:00:00Z"
  }
]